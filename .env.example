
HARNESS=pi
HARNESS_SECURITY_POSTURE=auto

#ANTHROPIC_API_KEY=sk-ant-...
#OPENAI_API_KEY=sk-...
#OPENROUTER_API_KEY=sk-or-...

ORG_ID=acme
PORT=8080

#SLACK_BOT_TOKEN=xoxb-...
#SLACK_APP_TOKEN=xapp-...

CORE_SIGNING_SECRET=
CAPABILITY_SECRET=
PORTAL_IDENTITY_SECRET=
CONNECTOR_SECRET_KEY=
SKILL_SIGNING_SECRET=

RATE_LIMIT_PER_WINDOW=60
RATE_LIMIT_WINDOW_MS=60000
BUDGET_USD_PER_WINDOW=25
ORG_BUDGET_USD_PER_WINDOW=100
BUDGET_WINDOW_MS=86400000

# Publicly shareable read-only conversation links. ON when unset; set to 0 to
# turn the feature off entirely (no share store is built, minting answers 503
# and every existing link answers 404).
#PUBLIC_SHARE_LINKS=0
# The portal's own hop for the same feature, also ON when unset. Set to 0 to stop
# the portal relaying anonymous share traffic without disabling core's routes.
#PORTAL_PUBLIC_SHARE_LINKS=0
# Per-client ceilings for anonymous share traffic, applied in the portal because
# core never receives a client IP on this path. Three buckets: transcript views
# and polls, attachment downloads, and the SPA bundle the share page loads (a
# cold page load is ~10 of those, so it must not spend the reader's poll budget).
# Each is capped at 64 — core grants at most 64 claim slots per request.
#PORTAL_SHARE_VIEWS_PER_IP=60
#PORTAL_SHARE_FILES_PER_IP=30
#PORTAL_SHARE_ASSETS_PER_IP=64
#PORTAL_SHARE_RATE_WINDOW_S=60
# Number of trusted reverse proxies in front of the portal — 1 for Traefik/Dokploy.
# REQUIRED in production while share links are on: it is what makes the per-client
# bucket key trustworthy. Without it the portal still limits, but on the last
# X-Forwarded-For hop, which a client can forge; production refuses to boot unless
# you either set this or accept that trade explicitly below.
PORTAL_XFF_TRUSTED_HOPS=1
# Accept the best-effort (spoofable) client key in production instead of setting
# PORTAL_XFF_TRUSTED_HOPS. Off unless explicitly set.
#PORTAL_SHARE_RATE_LIMIT_BEST_EFFORT=1
